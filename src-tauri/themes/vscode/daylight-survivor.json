{
  "name": "Daylight Survivor",
  "type": "light",
  "colors": {
    "editor.background": "#FFF8DC",
    "editor.foreground": "#2F4F4F",
    "activityBar.background": "#FFD700",
    "activityBar.foreground": "#2F4F4F",
    "sideBar.background": "#FFFACD",
    "sideBar.foreground": "#2F4F4F",
    "statusBar.background": "#FFA500",
    "statusBar.foreground": "#2F4F4F",
    "titleBar.activeBackground": "#FFD700",
    "titleBar.activeForeground": "#2F4F4F"
  },
  "tokenColors": [
    {
      "scope": ["comment"],
      "settings": {
        "foreground": "#8B7355",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "storage"],
      "settings": {
        "foreground": "#FF6347"
      }
    },
    {
      "scope": ["string"],
      "settings": {
        "foreground": "#228B22"
      }
    },
    {
      "scope": ["variable", "entity.name"],
      "settings": {
        "foreground": "#2F4F4F"
      }
    }
  ]
}
