{
  "name": "Sit or Live - Frozen Dead",
  "type": "dark",
  "colors": {
    "editor.background": "#1A1A2E",
    "editor.foreground": "#B0E0E6",
    "editorCursor.foreground": "#B0E0E6",
    "editor.lineHighlightBackground": "#232338",
    "editor.selectionBackground": "#2C2C42",
    "sideBar.background": "#232338",
    "activityBar.background": "#232338",
    "statusBar.background": "#2C2C42",
    "terminal.ansiBlack": "#1A1A2E",
    "terminal.ansiRed": "#FF6B6B",
    "terminal.ansiGreen": "#98FB98",
    "terminal.ansiYellow": "#FFE4B5",
    "terminal.ansiBlue": "#ADD8E6",
    "terminal.ansiMagenta": "#B0C4DE",
    "terminal.ansiCyan": "#87CEEB",
    "terminal.ansiWhite": "#B0E0E6"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#4A4A5E"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#98FB98"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#B0C4DE"
      }
    },
    {
      "scope": [
        "function"
      ],
      "settings": {
        "foreground": "#ADD8E6"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#FF6B6B"
      }
    }
  ]
}