{
  "name": "Sit or Live - Daylight Survivor",
  "type": "light",
  "colors": {
    "editor.background": "#FFF8DC",
    "editor.foreground": "#654321",
    "editorCursor.foreground": "#654321",
    "editor.lineHighlightBackground": "#F5DEB3",
    "editor.selectionBackground": "#DEB887",
    "sideBar.background": "#F5DEB3",
    "activityBar.background": "#F5DEB3",
    "statusBar.background": "#DEB887",
    "terminal.ansiBlack": "#FFF8DC",
    "terminal.ansiRed": "#FF6347",
    "terminal.ansiGreen": "#32CD32",
    "terminal.ansiYellow": "#FFD700",
    "terminal.ansiBlue": "#1E90FF",
    "terminal.ansiMagenta": "#9370DB",
    "terminal.ansiCyan": "#00CED1",
    "terminal.ansiWhite": "#654321"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#D2691E"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#32CD32"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#9370DB"
      }
    },
    {
      "scope": [
        "function"
      ],
      "settings": {
        "foreground": "#1E90FF"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#FF6347"
      }
    }
  ]
}